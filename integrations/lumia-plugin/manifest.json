{
  "id": "factory_live_chaos",
  "name": "Factory Live Chaos",
  "version": "1.4.1",
  "icon": "icon.png",
  "author": "LumiCon",
  "website": "https://lumi-con.com/factory-live/lumia/",
  "description": "Spawn creatures, drop Nobelisks, and run Satisfactory viewer effects through the local Factory Live bridge.",
  "lumiaVersion": "^9.4.0",
  "category": "apps",
  "main": "main.js",
  "config": {
    "settings": [],
    "settings_tutorial": "./tutorial.md",
    "actions_tutorial": "./tutorial.md",
    "alerts": [
      {
        "key": "pioneer_death",
        "title": "Pioneer Death",
        "defaultMessage": "The pioneer died in Satisfactory."
      }
    ],
    "actions": [
      {
        "type": "arm_bridge",
        "label": "Arm Bridge",
        "description": "Enable viewer effects on the running bridge when the host game is ready. For broadcaster controls.",
        "fields": [],
        "acceptedVariables": [
          "factory_live_chaos_status",
          "factory_live_chaos_result"
        ]
      },
      {
        "type": "disarm_bridge",
        "label": "Disarm Bridge",
        "description": "Pause viewer effects and clear queued work. For broadcaster controls.",
        "fields": [],
        "acceptedVariables": [
          "factory_live_chaos_status",
          "factory_live_chaos_result"
        ]
      },
      {
        "type": "spawn_hog",
        "label": "Spawn Hog",
        "description": "Queue the selected creature variant around the pioneer.",
        "fields": [
          {
            "key": "variant",
            "label": "Tier",
            "type": "select",
            "required": true,
            "defaultValue": 0,
            "options": [
              {
                "label": "Standard",
                "value": 0
              },
              {
                "label": "Alpha",
                "value": 1
              },
              {
                "label": "Cliff",
                "value": 2
              },
              {
                "label": "Nuclear",
                "value": 3
              },
              {
                "label": "Jetpack",
                "value": 4
              }
            ]
          },
          {
            "key": "quantity",
            "label": "Quantity",
            "type": "number",
            "required": true,
            "min": 1,
            "max": 300,
            "step": 1,
            "defaultValue": 10,
            "helperText": "Base quantity before the multiplier."
          },
          {
            "key": "multiplier",
            "label": "Multiplier",
            "type": "text",
            "defaultValue": "1",
            "placeholder": "1",
            "allowVariables": true,
            "helperText": "Enter a number or use a Lumia variable. The total is rounded to the nearest whole item."
          }
        ],
        "acceptedVariables": [
          "factory_live_chaos_status",
          "factory_live_chaos_result",
          "factory_live_chaos_selected_preset",
          "factory_live_chaos_quantity"
